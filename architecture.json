{
  "kind": "layered",
  "title": "Tablekeeper Stage 1 Architecture",
  "layers": [
    {
      "id": "entry",
      "title": "Container Entry",
      "items": [
        {
          "id": "dockerfile",
          "label": "Dockerfile (node:22-slim)"
        },
        {
          "id": "entrypoint",
          "label": "node src/server.js (PORT 0.0.0.0:8080)"
        }
      ]
    },
    {
      "id": "http",
      "title": "HTTP Layer",
      "items": [
        {
          "id": "express",
          "label": "Express app + express.json()"
        },
        {
          "id": "router",
          "label": "Route dispatch (sync handlers)"
        }
      ]
    },
    {
      "id": "api",
      "title": "API Surface",
      "items": [
        {
          "id": "health_route",
          "label": "GET /health"
        },
        {
          "id": "auth_routes",
          "label": "POST /auth/signup, POST /auth/login"
        },
        {
          "id": "restaurant_routes",
          "label": "GET /restaurants, GET /restaurants/{id}"
        },
        {
          "id": "availability_route",
          "label": "GET /availability"
        },
        {
          "id": "reservation_routes",
          "label": "POST/GET/PATCH/CANCEL /reservations"
        },
        {
          "id": "moves_route",
          "label": "POST /reservation-moves"
        },
        {
          "id": "test_routes",
          "label": "POST /_test/reset, GET /_test/export, POST /_test/import"
        }
      ]
    },
    {
      "id": "core",
      "title": "Business Logic",
      "items": [
        {
          "id": "storage",
          "label": "In-memory store (sync)"
        },
        {
          "id": "auth_logic",
          "label": "Auth: scrypt hash, token store"
        },
        {
          "id": "time_logic",
          "label": "DST-aware time resolver"
        },
        {
          "id": "idempotency_logic",
          "label": "Idempotency key ledger"
        },
        {
          "id": "reservation_logic",
          "label": "Booking, cancel, amend, moves"
        }
      ]
    }
  ],
  "flows": [
    {
      "from": "entry",
      "to": "http",
      "label": "HTTP request"
    },
    {
      "from": "http",
      "to": "api",
      "label": "JSON"
    },
    {
      "from": "api",
      "to": "core",
      "label": "business rules"
    }
  ]
}
